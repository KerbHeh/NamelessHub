-- ============================================================
local XRaySystem = {}
XRaySystem.__index = XRaySystem

function XRaySystem.new()
    local self = setmetatable({}, XRaySystem)
    self.Highlights = {}
    self.Billboards = {}
    self.Connection = nil
    self.LastUpdate = 0
    return self
end

function XRaySystem:RemovePlayer(player)
    local hl = self.Highlights[player]
    if hl then
        if hl.Parent then hl:Destroy() end
        self.Highlights[player] = nil
    end
    local bb = self.Billboards[player]
    if bb then
        if bb.Parent then bb:Destroy() end
        self.Billboards[player] = nil
    end
end

function XRaySystem:Clear()
    for plr in pairs(self.Highlights) do self:RemovePlayer(plr) end
    for plr in pairs(self.Billboards) do self:RemovePlayer(plr) end
    self.Highlights = {}
    self.Billboards = {}
end

function XRaySystem:ComputeColor(player, dist, hpPercent, kills)
    local color, priority = nil, 0
    if Config.XRay.LowHealth.Enabled and hpPercent <= Config.XRay.LowHealth.MaxHPPercent then
        color, priority = Config.XRay.LowHealth.Color, 3
    end
    if Config.XRay.LowKills.Enabled and kills <= Config.XRay.LowKills.MaxKills and priority < 2 then
        color, priority = Config.XRay.LowKills.Color, 2
    end
    if Config.XRay.Nearby.Enabled and dist <= Config.XRay.Nearby.MaxDistance and priority < 1 then
        color, priority = Config.XRay.Nearby.Color, 1
    end
    return color
end

function XRaySystem:Apply(player)
    if player == LocalPlayer or not IsAlive(player) then
        self:RemovePlayer(player)
        return
    end
    local char = player.Character
    if not char then
        self:RemovePlayer(player)
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        self:RemovePlayer(player)
        return
    end

    local dist = DistanceTo(root.Position)
    if dist > Config.Settings.PlayerDetectionDistance then
        self:RemovePlayer(player)
        return
    end

    local hp, maxHp = GetPlayerHP(player)
    local hpPercent = (hp / math.max(maxHp, 1)) * 100
    local kills = GetPlayerKills(player)
    local color = self:ComputeColor(player, dist, hpPercent, kills)

    if not color then
        self:RemovePlayer(player)
        return
    end

    local hl = self.Highlights[player]
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.FillTransparency = 0.55
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        self.Highlights[player] = hl
    end
    hl.FillColor = color
    hl.OutlineColor = color

    if Config.Settings.ShowPlayerInfo then
        local bb = self.Billboards[player]
        if not bb or not bb.Parent then
            bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 160, 0, 70)
            bb.StudsOffset = Vector3.new(0, 3.2, 0)
            bb.AlwaysOnTop = true
            bb.Adornee = root
            bb.Parent = char
            local label = Instance.new("TextLabel")
            label.Name = "Info"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 0.45
            label.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextSize = 12
            label.Font = Enum.Font.GothamBold
            label.TextStrokeTransparency = 0.5
            label.Parent = bb
            Instance.new("UICorner", label).CornerRadius = UDim.new(0, 6)
            self.Billboards[player] = bb
        end
        local text = ""
        if Config.XRay.ShowName then text ..= player.Name .. "\n" end
        if Config.XRay.ShowHP then text ..= string.format("HP: %.0f/%.0f\n", hp, maxHp) end
        if Config.XRay.ShowKills then text ..= "Kills: " .. kills .. "\n" end
        if Config.XRay.ShowDistance then text ..= string.format("Dist: %.0f", dist) end
        if bb:FindFirstChild("Info") then
            bb.Info.Text = text
        end
    else
        local bb = self.Billboards[player]
        if bb then
            if bb.Parent then bb:Destroy() end
            self.Billboards[player] = nil
        end
    end
end

function XRaySystem:Update()
    if Config.Settings.Panic or not Config.XRay.Enabled then
        self:Clear()
        return
    end
    local now = os.clock()
    if now - self.LastUpdate < Config.XRay.UpdateRate then return end
    self.LastUpdate = now

    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        seen[plr] = true
        self:Apply(plr)
    end
    local tracked = {}
    for plr in pairs(self.Highlights) do tracked[plr] = true end
    for plr in pairs(self.Billboards) do tracked[plr] = true end
    for plr in pairs(tracked) do
        if not seen[plr] then self:RemovePlayer(plr) end
    end
end

function XRaySystem:Start()
    if self.Connection then return end
    self.Connection = TrackConnection(RunService.Heartbeat:Connect(function() self:Update() end))
end

function XRaySystem:Stop()
    if self.Connection then self.Connection:Disconnect() self.Connection = nil end
    self:Clear()
end

local XRay = XRaySystem.new()

