local function BuildActiveSteps(tech, presetName)
    if not IsConfigured(tech) then return {} end
    presetName = presetName or "Default"
    local preset = tech.Presets[presetName]
    if not preset or next(preset) == nil then
        preset = tech.Presets.Default or {}
    end
    local mult = Config.Tech.TimingMultiplier * Config.Settings.TechTimingMultiplier
    local out = {}
    for i, step in ipairs(tech.Steps) do
        local delayAfter = (preset[i] ~= nil and preset[i] or step.DelayAfter or 0.1) * mult
        delayAfter = math.clamp(delayAfter, Config.Tech.MinDelay, Config.Tech.MaxDelay)
        local delayBefore = (step.DelayBefore or 0) * mult
        local globalDelay = math.max(0, Config.Settings.GlobalDelay or 0)
        table.insert(out, {
            Input = step.Input,
            DelayBefore = delayBefore + globalDelay,
            DelayAfter = delayAfter,
            ExecutionWindow = step.ExecutionWindow or Config.Tech.DefaultExecutionWindow,
            Description = step.Description or "",
            Index = i,
        })
    end
    return out
end

local function LibraryDisplayName(tech)
    local fav = Config.Tech.Favorites[tech.Name] and "★ " or ""
    return string.format("%s%s — %s", fav, tech.Name, GetConfigLabel(tech))
end

local function GetLibraryValues()
    local list = {}
    for _, t in ipairs(TechLibrary) do
        table.insert(list, LibraryDisplayName(t))
