    return list
end

local function ParseLibrarySelection(display)
    local name = string.match(display, "★?%s*(.-)%s*—")
    if name then
        name = string.gsub(name, "^%s+", "")
        name = string.gsub(name, "%s+$", "")
        return FindTechByName(name)
    end
    return FindTechByName(display)
end

