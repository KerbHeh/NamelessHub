local function SaveData(silent)
    if not CanUseFileIO() then
        if not silent then Notify("Persistence", "File saving is unavailable in this environment.") end
        return false
    end
    if os.clock() - Runtime.LastSave < Runtime.SaveCooldown then return false end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(BuildSaveData()) end)
    if not ok then
        if not silent then Notify("Persistence", "Could not encode settings.") end
        return false
    end
    local wrote = pcall(writefile, DATA_FILE, encoded)
    if wrote then
        Runtime.LastSave = os.clock()
        if not silent then Notify("Persistence", "Alpha configuration saved.") end
        return true
    end
    if not silent then Notify("Persistence", "Could not write the configuration file.") end
    return false
end

local function LoadData()
    if not CanUseFileIO() or not isfile(DATA_FILE) then return false end
    local okRead, raw = pcall(readfile, DATA_FILE)
    if not okRead or type(raw) ~= "string" then return false end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode or type(data) ~= "table" then return false end

    local function copyNumber(dst, src, key) if type(src[key]) == "number" then dst[key] = src[key] end end
    local function copyBool(dst, src, key) if type(src[key]) == "boolean" then dst[key] = src[key] end end
    if type(data.Settings) == "table" then
        for _, key in ipairs({"PlayerDetectionDistance","GlobalDelay","TechTimingMultiplier"}) do copyNumber(Config.Settings, data.Settings, key) end
        copyBool(Config.Settings, data.Settings, "PerformanceMode")
        copyBool(Config.Settings, data.Settings, "ShowPlayerInfo")
        copyBool(Config.Settings, data.Settings, "ShowTechInfo")
        if type(data.Settings.DashKeyName) == "string" and KEY_NAME_TO_ENUM[data.Settings.DashKeyName] then Config.Settings.DashKeyName = data.Settings.DashKeyName end
    end
    if type(data.Farm) == "table" then
        for _, key in ipairs({"MaxDistance","MovementSpeed","InteractionDelay"}) do copyNumber(Config.Farm, data.Farm, key) end
        if type(data.Farm.KillStats) == "table" then
            copyNumber(Config.Farm.KillStats, data.Farm.KillStats, "TotalKills")
        end
        for _, key in ipairs({"IgnoreUsed","AntiStuck","AutoRecalculate","AutoBucketAttack","BucketTeleport","BucketAutoLoop"}) do copyBool(Config.Farm, data.Farm, key) end
        for _, key in ipairs({"BucketSearchRadius","BucketThrowDelay"}) do copyNumber(Config.Farm, data.Farm, key) end
        if data.Farm.BucketTargetMode == "Low Health" or data.Farm.BucketTargetMode == "Noobs / Low Kills" or data.Farm.BucketTargetMode == "Nearby" then
            Config.Farm.BucketTargetMode = data.Farm.BucketTargetMode
        end
    end
    if type(data.XRay) == "table" then
        copyNumber(Config.XRay, data.XRay, "UpdateRate")
        for _, key in ipairs({"ShowName","ShowHP","ShowKills","ShowDistance"}) do copyBool(Config.XRay, data.XRay, key) end
        if type(data.XRay.LowHealth) == "table" then copyBool(Config.XRay.LowHealth, data.XRay.LowHealth, "Enabled"); copyNumber(Config.XRay.LowHealth, data.XRay.LowHealth, "MaxHPPercent") end
        if type(data.XRay.LowKills) == "table" then copyBool(Config.XRay.LowKills, data.XRay.LowKills, "Enabled"); copyNumber(Config.XRay.LowKills, data.XRay.LowKills, "MaxKills") end
        if type(data.XRay.Nearby) == "table" then copyBool(Config.XRay.Nearby, data.XRay.Nearby, "Enabled"); copyNumber(Config.XRay.Nearby, data.XRay.Nearby, "MaxDistance") end
    end
    if type(data.Tech) == "table" then
        copyNumber(Config.Tech, data.Tech, "TimingMultiplier")
        copyNumber(Config.Tech, data.Tech, "DefaultExecutionWindow")
        copyNumber(Config.Tech, data.Tech, "AutoStartDelay")
        copyNumber(Config.Tech, data.Tech, "AutoInputReleaseDelay")
        copyBool(Config.Tech, data.Tech, "AutoLoop")
        if type(data.Tech.Favorites) == "table" then Config.Tech.Favorites = data.Tech.Favorites end
        if type(data.Tech.Library) == "table" then
            for _, saved in ipairs(data.Tech.Library) do
                if type(saved.Name) == "string" then
                    local tech = FindTechByName(saved.Name)
                    if tech then
                        if type(saved.Steps) == "table" then tech.Steps = saved.Steps end
                        if type(saved.Presets) == "table" then tech.Presets = saved.Presets end
                        if type(saved.Description) == "string" then tech.Description = saved.Description end
                    end
                end
            end
        end
    end
    return true
end

SafeCall(LoadData)

local function GetRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local c = player.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function GetPlayerKills(player)
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return 0 end
    local k = ls:FindFirstChild("Kills") or ls:FindFirstChild("Kill")
    return k and k.Value or 0
end

local function GetPlayerHP(player)
    local c = player.Character
    if not c then return 0, 100 end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return 0, 100 end
    return h.Health, h.MaxHealth
end

-- ============================================================
-- KILL COUNTER
-- View kills = kills credited by this hub during the current run/server.
-- Total kills = persisted counter across servers (best-effort via file IO).
-- A kill is credited only to a target that was recently attacked by the
-- autonomous bucket system and then dies within the attribution window.
-- ============================================================
local KillTracker = {
    Pending = {},
    Connections = {},
    AttributionWindow = 6,
}

local function RefreshKillDisplay()
    return Config.Farm.KillStats.ServerKills or 0, Config.Farm.KillStats.TotalKills or 0
end

local function DisconnectKillConnection(player)
    local conn = KillTracker.Connections[player]
    if conn then
        pcall(function() conn:Disconnect() end)
        KillTracker.Connections[player] = nil
    end
end

local function WatchPotentialKill(player)
    if not player or player == LocalPlayer then return end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    KillTracker.Pending[player] = os.clock()
    DisconnectKillConnection(player)
    KillTracker.Connections[player] = hum.Died:Connect(function()
        local attackedAt = KillTracker.Pending[player]
        if attackedAt and (os.clock() - attackedAt) <= KillTracker.AttributionWindow then
            Config.Farm.KillStats.ServerKills += 1
            Config.Farm.KillStats.TotalKills += 1
            KillTracker.Pending[player] = nil
            SaveData(true)
            Notify("Bucket Farm", string.format("Kill confirmed! Server: %d | Total: %d", Config.Farm.KillStats.ServerKills, Config.Farm.KillStats.TotalKills), 3)
        end
        DisconnectKillConnection(player)
    end)
end

local function CleanupExpiredKillCandidates()
    local now = os.clock()
    for player, attackedAt in pairs(KillTracker.Pending) do
        if now - attackedAt > KillTracker.AttributionWindow or not player.Parent then
            KillTracker.Pending[player] = nil
            DisconnectKillConnection(player)
        end
    end
end

local function ResetServerKillCounter()
    Config.Farm.KillStats.ServerKills = 0
    KillTracker.Pending = {}
    for player in pairs(KillTracker.Connections) do DisconnectKillConnection(player) end
end

ResetServerKillCounter()

local function DistanceTo(pos)
    local r = GetRoot()
    if not r then return math.huge end
    return (r.Position - pos).Magnitude
end

-- ============================================================
-- PLAYER FILTER → real candidate list
-- ============================================================
local function GetFilteredPlayerTargets()
    local root = GetRoot()
    if not root then return {} end

    local anyFilter =
        Config.PlayerFilters.Nearby.Enabled
        or Config.PlayerFilters.LowKills.Enabled
        or Config.PlayerFilters.LowHealth.Enabled

    -- If no filter enabled, return empty (user must enable at least one)
    if not anyFilter then return {} end

    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local char = plr.Character
            local pRoot = char and char:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local dist = (root.Position - pRoot.Position).Magnitude
                local hp, maxHp = GetPlayerHP(plr)
                local hpPercent = (hp / math.max(maxHp, 1)) * 100
                local kills = GetPlayerKills(plr)

                local pass = true

                if Config.PlayerFilters.Nearby.Enabled then
                    if dist > Config.PlayerFilters.Nearby.MaxDistance then
                        pass = false
                    end
                end
                if pass and Config.PlayerFilters.LowKills.Enabled then
                    if kills > Config.PlayerFilters.LowKills.MaxKills then
                        pass = false
                    end
                end
                if pass and Config.PlayerFilters.LowHealth.Enabled then
                    if hpPercent > Config.PlayerFilters.LowHealth.MaxHPPercent then
                        pass = false
                    end
                end
                -- SkipUltimate: not available

                if pass and dist <= Config.Settings.PlayerDetectionDistance then
                    table.insert(list, {
                        Player = plr,
                        Distance = dist,
                        HP = hpPercent,
                        Kills = kills,
                        Position = pRoot.Position,
                    })
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.Distance < b.Distance end)
    return list
end

