-- PRESET HELPERS
-- ============================================================
local function SnapshotDelaysFromSteps(tech)
    local map = {}
    for i, s in ipairs(tech.Steps) do
        map[i] = s.DelayAfter or 0.1
    end
    return map
end

local function ApplyPresetToSteps(tech, presetName)
    local preset = tech.Presets[presetName]
    if not preset or next(preset) == nil then return false end
    for i, s in ipairs(tech.Steps) do
        if preset[i] ~= nil then
            s.DelayAfter = preset[i]
        end
    end
    return true
end

local function SavePresetFromSteps(tech, presetName)
    if not tech.Presets[presetName] then
        tech.Presets[presetName] = {}
    end
    tech.Presets[presetName] = SnapshotDelaysFromSteps(tech)
    return true
end

local function DeletePreset(tech, presetName)
    if presetName == "Default" then
        return false, "Cannot delete Default"
    end
    tech.Presets[presetName] = {}
    return true
end

local function ResetPreset(tech, presetName)
    if presetName == "Default" then
        tech.Presets.Default = SnapshotDelaysFromSteps(tech)
        return true
    end
    tech.Presets[presetName] = {}
    return true
end

