                selectedTech.Presets.Default = SnapshotDelaysFromSteps(selectedTech)
            else
                selectedTech.Presets[selectedPreset] = {}
            end
            Notify("Preset", selectedPreset .. " reset")
        end,
    })

    RefreshTechInfo()

    -- Practice / Demo
    local RunSec = TechTab:Section({ Title = "Tech Runtime", Opened = true })
    RunSec:Paragraph({
        Title = "Modes",
        Desc = "Auto executes the configured sequence through virtual input. Practice only scores your own inputs. Demo previews timing.",
    })
    local RunStatus = RunSec:Paragraph({ Title = "Runtime Status", Desc = "Idle" })

    local function OnEngineUpdate(data)
        if data.Complete then
            if data.Demo then
                RunStatus:SetDesc("DEMO COMPLETE")
            else
                RunStatus:SetDesc(string.format(
                    "TECH COMPLETE\nAccuracy: %d%% | Mistakes: %d\nAvg: %d ms | Best: %d ms",
                    data.Accuracy or 0, data.Mistakes or 0,
                    data.AverageTiming or 0, data.BestTiming or 0
                ))
            end
            RefreshTechInfo()
            return
        end
        if data.DemoPreview then
            RunStatus:SetDesc("SEQUENCE:\n" .. (data.SequenceText or ""))
            return
        end
        if data.Stopped then
            RunStatus:SetDesc("Stopped")
            RefreshTechInfo()
            return
        end
        local resultTag = data.Result and (" | " .. tostring(data.Result)) or ""
        RunStatus:SetDesc(string.format(
            "Mode: %s\nStep %d / %d\nExpected: %s\nNext: %s\nTarget Delay: %.3fs\nWindow: ±%.3fs\nTime Remaining: %.3fs\nAccuracy: %d%%%s",
            data.Mode or "—",
            data.CurrentStep or 0, data.TotalSteps or 0,
            data.CurrentInput or "—",
            data.NextInput or "—",
            data.TargetDelay or 0,
            data.ExecutionWindow or 0,
            data.TimeRemaining or 0,
            data.Accuracy or 0,
            resultTag
        ))
    end

    RunSec:Toggle({
        Title = "Retry Step on Miss/Wrong",
        Value = true, Flag = "RetryOnMiss",
        Callback = function(v) Config.Tech.RetryOnMiss = v end,
    })
    RunSec:Toggle({
        Title = "Auto Loop Tech", Value = false, Flag = "AutoTechLoop",
        Callback = function(v) Config.Tech.AutoLoop = v end,
    })
    RunSec:Button({
        Title = "AUTO EXECUTE TECH", Icon = "zap",
        Callback = function()
            if not selectedTech then return end
            local ok, err = Engine:StartAuto(selectedTech, selectedPreset, OnEngineUpdate)
            if not ok then
                Notify("Auto Tech", err or "Failed")
                RunStatus:SetDesc(err or "Failed")
            else
                Notify("Auto Tech", "Autonomous sequence started", 3)
            end
            RefreshTechInfo()
        end,
    })
    RunSec:Button({
        Title = "Practice Mode (Trainer)",
        Icon = "play",
        Callback = function()
            if not selectedTech then return end
            local ok, err = Engine:StartPractice(selectedTech, selectedPreset, OnEngineUpdate)
            if not ok then
                Notify("Practice", err or "Failed")
                RunStatus:SetDesc(err or "Failed")
            else
                Notify("Practice", "Trainer started — press expected inputs")
            end
            RefreshTechInfo()
        end,
    })
    RunSec:Button({
        Title = "Demonstration Mode",
        Icon = "eye",
        Callback = function()
            if not selectedTech then return end
            local ok, err = Engine:StartDemo(selectedTech, selectedPreset, OnEngineUpdate)
            if not ok then
                Notify("Demo", err or "Failed")
                RunStatus:SetDesc(err or "Failed")
            end
            RefreshTechInfo()
        end,
    })
    RunSec:Button({
        Title = "Stop",
        Icon = "square",
        Callback = function()
            Engine:Stop()
            RunStatus:SetDesc("Stopped")
            RefreshTechInfo()
        end,
    })

    local TimingSec = TechTab:Section({ Title = "Global Timing", Opened = true })
    TimingSec:Slider({
        Title = "Timing Multiplier",
        Value = { Min = 0.5, Max = 2.0, Default = 1.0 }, Step = 0.05, Flag = "TechMult",
        Callback = function(v) Config.Tech.TimingMultiplier = v end,
    })
    TimingSec:Slider({
        Title = "Default Execution Window",
        Value = { Min = 0.01, Max = 0.15, Default = 0.03 }, Step = 0.01, Flag = "ExecWindow",
        Callback = function(v) Config.Tech.DefaultExecutionWindow = v end,
    })

    -- Step editor with explicit value readout (fixes UX sync)
    local EditorSec = TechTab:Section({ Title = "Step Editor", Opened = true })
    local EditorDisplay = EditorSec:Paragraph({
        Title = "Steps",
        Desc = "No steps — Tech is Unconfigured",
    })
    local StepValueDisplay = EditorSec:Paragraph({
        Title = "Selected Step Values",
        Desc = "—",
    })

    function RefreshEditorDisplay()
        if #editBuffer == 0 then
            EditorDisplay:SetDesc("No steps — Tech is Unconfigured\nUse Add Step to begin.")
            StepValueDisplay:SetDesc("—")
            return
        end
        local lines = {}
        for i, s in ipairs(editBuffer) do
            local mark = (i == editStepIndex) and "► " or "  "
            table.insert(lines, string.format(
                "%sStep %d | %s | Before: %.2fs After: %.2fs | Window: ±%.2fs",
                mark, i, InputLabel(s.Input), s.DelayBefore or 0, s.DelayAfter or 0.1, s.ExecutionWindow or 0.03
            ))
        end
        EditorDisplay:SetDesc(table.concat(lines, "\n"))
        local s = editBuffer[editStepIndex]
        if s then
            StepValueDisplay:SetDesc(string.format(
                "Editing Step %d\nInput: %s\nDelay Before: %.3fs\nDelay After: %.3fs\nExecution Window: ±%.3fs\n%s",
                editStepIndex, InputLabel(s.Input),
                s.DelayBefore or 0, s.DelayAfter or 0.1, s.ExecutionWindow or 0.03,
                s.Description or ""
            ))
        end
    end

    function LoadStepIntoUIFields()
        local s = editBuffer[editStepIndex]
        if not s then
            uiDelayBefore, uiDelayAfter, uiExecWindow = 0, 0.10, 0.03
            return
        end
        uiDelayBefore = s.DelayBefore or 0
        uiDelayAfter = s.DelayAfter or 0.10
        uiExecWindow = s.ExecutionWindow or 0.03
        RefreshEditorDisplay()
    end

    if selectedTech then
        for _, s in ipairs(selectedTech.Steps) do
            table.insert(editBuffer, {
                Input = s.Input,
                DelayBefore = s.DelayBefore or 0,
                DelayAfter = s.DelayAfter or 0.1,
                ExecutionWindow = s.ExecutionWindow or 0.03,
                Description = s.Description or "",
            })
        end
    end
    LoadStepIntoUIFields()

    EditorSec:Dropdown({
        Title = "Select Step to Edit",
        Values = (function()
            local t = {}
            for i = 1, 32 do table.insert(t, "Step " .. i) end
            return t
        end)(),
        Value = "Step 1",
        Callback = function(v)
            local n = tonumber(string.match(v, "%d+")) or 1
            editStepIndex = math.clamp(n, 1, math.max(1, #editBuffer))
            LoadStepIntoUIFields()
        end,
    })

    EditorSec:Dropdown({
        Title = "Input",
        Values = AVAILABLE_INPUTS,
        Value = "M1",
        Callback = function(inp)
            if editBuffer[editStepIndex] then
                editBuffer[editStepIndex].Input = inp
                RefreshEditorDisplay()
            end
        end,
    })

    EditorSec:Slider({
        Title = "Delay Before (s)",
        Value = { Min = 0, Max = 1, Default = 0 },
        Step = 0.01,
        Callback = function(v)
            uiDelayBefore = v
            if editBuffer[editStepIndex] then
                editBuffer[editStepIndex].DelayBefore = v
                RefreshEditorDisplay()
            end
        end,
    })
    EditorSec:Slider({
        Title = "Delay After (s)",
        Value = { Min = 0.01, Max = 2, Default = 0.10 },
        Step = 0.01,
        Callback = function(v)
            uiDelayAfter = v
            if editBuffer[editStepIndex] then
                editBuffer[editStepIndex].DelayAfter = v
                RefreshEditorDisplay()
            end
        end,
    })
    EditorSec:Slider({
        Title = "Execution Window (±s)",
        Value = { Min = 0.01, Max = 0.20, Default = 0.03 },
        Step = 0.01,
        Callback = function(v)
            uiExecWindow = v
            if editBuffer[editStepIndex] then
                editBuffer[editStepIndex].ExecutionWindow = v
                RefreshEditorDisplay()
            end
        end,
    })
    EditorSec:Input({
        Title = "Step Description",
        Placeholder = "Optional...",
        Value = "",
        Callback = function(t)
            if editBuffer[editStepIndex] then
                editBuffer[editStepIndex].Description = t or ""
                RefreshEditorDisplay()
            end
        end,
    })

    EditorSec:Button({
        Title = "Add Step", Icon = "plus",
        Callback = function()
            table.insert(editBuffer, {
                Input = "M1", DelayBefore = 0, DelayAfter = 0.10,
                ExecutionWindow = Config.Tech.DefaultExecutionWindow, Description = "",
            })
            editStepIndex = #editBuffer
            LoadStepIntoUIFields()
            Notify("Editor", "Step " .. #editBuffer .. " added")
        end,
    })
    EditorSec:Button({
        Title = "Duplicate Step",
        Callback = function()
            if #editBuffer == 0 then return end
            local src = editBuffer[editStepIndex]
            table.insert(editBuffer, editStepIndex + 1, {
                Input = src.Input, DelayBefore = src.DelayBefore,
                DelayAfter = src.DelayAfter, ExecutionWindow = src.ExecutionWindow,
                Description = src.Description,
            })
            editStepIndex += 1
            LoadStepIntoUIFields()
        end,
    })
    EditorSec:Button({
        Title = "Move Up",
        Callback = function()
            if editStepIndex <= 1 or #editBuffer < 2 then return end
            editBuffer[editStepIndex], editBuffer[editStepIndex - 1] =
                editBuffer[editStepIndex - 1], editBuffer[editStepIndex]
            editStepIndex -= 1
            LoadStepIntoUIFields()
        end,
    })
    EditorSec:Button({
        Title = "Move Down",
        Callback = function()
            if editStepIndex >= #editBuffer or #editBuffer < 2 then return end
            editBuffer[editStepIndex], editBuffer[editStepIndex + 1] =
                editBuffer[editStepIndex + 1], editBuffer[editStepIndex]
            editStepIndex += 1
            LoadStepIntoUIFields()
        end,
    })
    EditorSec:Button({
        Title = "Delete Step", Icon = "trash",
        Callback = function()
            if #editBuffer == 0 then return end
            table.remove(editBuffer, editStepIndex)
            editStepIndex = math.clamp(editStepIndex, 1, math.max(1, #editBuffer))
            LoadStepIntoUIFields()
        end,
    })
    EditorSec:Button({
        Title = "Save Tech", Icon = "save",
        Callback = function()
            if not selectedTech then return end
            selectedTech.Steps = {}
            for i, s in ipairs(editBuffer) do
                selectedTech.Steps[i] = {
                    Input = s.Input,
                    DelayBefore = s.DelayBefore or 0,
                    DelayAfter = s.DelayAfter or 0.1,
                    ExecutionWindow = s.ExecutionWindow or 0.03,
                    Description = s.Description or "",
                }
            end
            selectedTech.Presets.Default = SnapshotDelaysFromSteps(selectedTech)
            RefreshTechInfo()
            RefreshEditorDisplay()
            SaveData(true)
            Notify("Editor", selectedTech.Name .. " → " .. GetConfigLabel(selectedTech) .. " (" .. #selectedTech.Steps .. " steps)")
        end,
    })
    EditorSec:Button({
        Title = "Reset Tech (clear steps)",
        Callback = function()
            if not selectedTech then return end
            editBuffer = {}
            selectedTech.Steps = {}
            selectedTech.Presets = { Default = {}, Fast = {}, Slow = {}, Custom = {} }
            editStepIndex = 1
            LoadStepIntoUIFields()
            RefreshTechInfo()
            SaveData(true)
            Notify("Editor", selectedTech.Name .. " → Unconfigured")
        end,
    })
    EditorSec:Button({
        Title = "Load Selected into Editor",
        Callback = function()
            if not selectedTech then return end
            editBuffer = {}
            for _, s in ipairs(selectedTech.Steps) do
                table.insert(editBuffer, {
                    Input = s.Input,
                    DelayBefore = s.DelayBefore or 0,
                    DelayAfter = s.DelayAfter or 0.1,
                    ExecutionWindow = s.ExecutionWindow or 0.03,
                    Description = s.Description or "",
                })
            end
            editStepIndex = math.max(1, #editBuffer)
            LoadStepIntoUIFields()
            Notify("Editor", "Loaded " .. #editBuffer .. " steps")
        end,
    })

    local NewSec = TechTab:Section({ Title = "Create New Tech", Opened = false })
    local NewName, NewCat, NewDiff, NewDesc = "", "Advanced", "Medium", ""
    NewSec:Input({ Title = "Name", Placeholder = "My Tech", Callback = function(v) NewName = v or "" end })
    NewSec:Dropdown({
        Title = "Category",
        Values = { "Movement / Dash", "M1 / Combo", "Move-Specific", "Advanced" },
        Value = "Advanced",
        Callback = function(v) NewCat = v end,
    })
    NewSec:Dropdown({
        Title = "Difficulty",
        Values = { "Easy", "Medium", "Hard" },
        Value = "Medium",
        Callback = function(v) NewDiff = v end,
    })
    NewSec:Input({ Title = "Description", Placeholder = "...", Callback = function(v) NewDesc = v or "" end })
    NewSec:Button({
        Title = "Create Unconfigured Tech",
        Callback = function()
            if NewName == "" then Notify("Create", "Name required") return end
            local t = MakeTech(NewName, NewCat, NewDiff, NewDesc ~= "" and NewDesc or nil)
            table.insert(TechLibrary, t)
            selectedTech = t
            editBuffer = {}
            RefreshTechInfo()
            RefreshEditorDisplay()
            Notify("Create", NewName .. " — Unconfigured")
        end,
    })
end

