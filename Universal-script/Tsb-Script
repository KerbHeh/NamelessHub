--==================================================
-- X-RAY LOOP
--==================================================

local function UpdateXRay(Player)

    if Player == LocalPlayer then
        return
    end

    local Character = Player.Character

    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Humanoid then
        return
    end

    local Highlight =
        Character:FindFirstChild("NamelessXRay")

    if not Highlight then

        Highlight = Instance.new("Highlight")
        Highlight.Name = "NamelessXRay"

        Highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        Highlight.FillTransparency = 0.65
        Highlight.OutlineTransparency = 0

        Highlight.FillColor =
            Color3.fromRGB(255, 60, 60)

        Highlight.OutlineColor =
            Color3.fromRGB(255, 255, 255)

        Highlight.Parent = Character
    end

    local Billboard =
        Character:FindFirstChild("NamelessXRayInfo")

    if not Billboard then

        Billboard = Instance.new("BillboardGui")
        Billboard.Name = "NamelessXRayInfo"
        Billboard.Size = UDim2.fromOffset(220, 70)
        Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        Billboard.AlwaysOnTop = true
        Billboard.Parent = Character

        local Text = Instance.new("TextLabel")
        Text.Name = "Info"
        Text.Size = UDim2.fromScale(1, 1)
        Text.BackgroundTransparency = 1
        Text.TextColor3 = Color3.fromRGB(255, 255, 255)
        Text.TextStrokeTransparency = 0
        Text.Font = Enum.Font.GothamBold
        Text.TextSize = 13
        Text.Parent = Billboard
    end

    local Text =
        Billboard:FindFirstChild("Info")

    if not Text then
        return
    end

    local RootLocal = GetRoot()

    local Distance = RootLocal
        and math.floor(
            (RootLocal.Position - Root.Position).Magnitude
        )
        or 0

    local HP = math.floor(Humanoid.Health)
    local MaxHP = math.floor(Humanoid.MaxHealth)

    local Lines = {}

    if Config.XRay.ShowName then
        table.insert(Lines, Player.Name)
    end

    if Config.XRay.ShowHealth then
        table.insert(
            Lines,
            string.format(
                "HP: %d / %d",
                HP,
                MaxHP
            )
        )
    end

    if Config.XRay.ShowDistance then
        table.insert(
            Lines,
            string.format(
                "Distance: %d",
                Distance
            )
        )
    end

    Text.Text = table.concat(Lines, "\n")
end

task.spawn(function()

    while task.wait(Config.XRay.UpdateRate) do

        if Config.XRay.Enabled then

            for _, Player in ipairs(Players:GetPlayers()) do

                if Player ~= LocalPlayer then
                    UpdateXRay(Player)
                end
            end

        else

            for _, Player in ipairs(Players:GetPlayers()) do

                if Player ~= LocalPlayer then

                    local Character = Player.Character

                    if Character then

                        local Highlight =
                            Character:FindFirstChild(
                                "NamelessXRay"
                            )

                        if Highlight then
                            Highlight:Destroy()
                        end

                        local Billboard =
                            Character:FindFirstChild(
                                "NamelessXRayInfo"
                            )

                        if Billboard then
                            Billboard:Destroy()
                        end
                    end
                end
            end
        end
    end
end)

