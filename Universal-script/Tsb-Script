local KEY_NAME_TO_ENUM = {
    W = Enum.KeyCode.W, A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D,
    Space = Enum.KeyCode.Space, Q = Enum.KeyCode.Q, E = Enum.KeyCode.E, F = Enum.KeyCode.F,
    Shift = Enum.KeyCode.LeftShift, Ctrl = Enum.KeyCode.LeftControl,
    R = Enum.KeyCode.R, T = Enum.KeyCode.T, G = Enum.KeyCode.G, H = Enum.KeyCode.H,
    Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V,
    One = Enum.KeyCode.One, Two = Enum.KeyCode.Two, Three = Enum.KeyCode.Three,
    Four = Enum.KeyCode.Four, Five = Enum.KeyCode.Five,
}

local function ResolveInput(expectedName)
    if expectedName == "M1" then
        return { Kind = "Mouse", Value = Enum.UserInputType.MouseButton1 }
    elseif expectedName == "M2" then
        return { Kind = "Mouse", Value = Enum.UserInputType.MouseButton2 }
    elseif expectedName == "Dash" then
        local key = KEY_NAME_TO_ENUM[Config.Settings.DashKeyName] or Enum.KeyCode.Q
        return { Kind = "Key", Value = key }
    else
        local key = KEY_NAME_TO_ENUM[expectedName]
        if key then return { Kind = "Key", Value = key } end
        return nil
    end
end

local function MatchInput(inputObject, expectedName)
    local resolved = ResolveInput(expectedName)
    if not resolved then return false end
    if resolved.Kind == "Mouse" then
        return inputObject.UserInputType == resolved.Value
    end
    return inputObject.KeyCode == resolved.Value
end

local function InputLabel(name)
    if name == "Dash" then
        return "Dash [" .. tostring(Config.Settings.DashKeyName) .. "]"
    end
    return name
end

