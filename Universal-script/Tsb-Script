-- FARM (Trashcan + Player)
-- ============================================================
local FarmSystem = {}
FarmSystem.__index = FarmSystem

function FarmSystem.new()
    local self = setmetatable({}, FarmSystem)
    self.Connection = nil
    self.LastPosition = nil
    self.StuckTimer = 0
    self.LastUsed = {}
    self.LastLoop = 0
    self.LoopInterval = 0.08
    self.NextInteractionAt = 0
    self.TrashcanCache = {}
    self.LastTrashcanScan = 0
    self.TrashcanScanInterval = 0.5
    return self
end

function FarmSystem:ScanTrashcans()
    local root = GetRoot()
    if not root then
        self.TrashcanCache = {}
        return
    end

    local cache = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and obj.Parent then
            local name = string.lower(obj.Name)
            if (string.find(name, "trash", 1, true)
                or string.find(name, "bin", 1, true)
                or string.find(name, "can", 1, true))
                and not string.find(name, "bucket", 1, true)
                and not string.find(name, "balde", 1, true) then
                local pos
                if obj:IsA("Model") then
                    local ok, pivot = pcall(function() return obj:GetPivot() end)
                    pos = (obj.PrimaryPart and obj.PrimaryPart.Position) or (ok and pivot.Position)
                else
                    pos = obj.Position
                end
                if pos then
                    table.insert(cache, { Instance = obj, Position = pos, Id = obj:GetFullName() })
                end
            end
        end
    end

    self.TrashcanCache = cache
    self.LastTrashcanScan = os.clock()
end

function FarmSystem:FindTrashcans()
    local root = GetRoot()
    if not root then return {} end

    if os.clock() - self.LastTrashcanScan >= self.TrashcanScanInterval then
        self:ScanTrashcans()
    end

    local valid = {}
    for _, target in ipairs(self.TrashcanCache) do
        if target.Instance and target.Instance.Parent then
            local pos = target.Instance:IsA("Model") and target.Instance:GetPivot().Position or target.Instance.Position
            local dist = (root.Position - pos).Magnitude
            if dist <= Config.Farm.MaxDistance then
                local recent = self.LastUsed[target.Id] and (os.clock() - self.LastUsed[target.Id]) < 8
                if not (Config.Farm.IgnoreUsed and recent) then
                    table.insert(valid, {
                        Instance = target.Instance,
                        Position = pos,
                        Distance = dist,
                        Id = target.Id,
                    })
                end
            end
        end
    end

    table.sort(valid, function(a, b) return a.Distance < b.Distance end)
    Config.Farm.FoundCount = #valid
    return valid
end

function FarmSystem:IsUsable(target)
    return target and target.Instance and target.Instance.Parent ~= nil
end

function FarmSystem:MoveTo(pos)
    local hum = GetHumanoid()
    if not hum or not pos then return false end
    hum.WalkSpeed = Config.Farm.MovementSpeed
    hum:MoveTo(pos)
    return true
end

function FarmSystem:TeleportTo(pos)
    local root = GetRoot()
    if not root or not pos then return false end
    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    return true
end

local function FindPromptOrClickDetector(instance)
    if not instance then return nil, nil end
    local prompt = instance:IsA("ProximityPrompt") and instance or instance:FindFirstChildWhichIsA("ProximityPrompt", true)
    local detector = instance:IsA("ClickDetector") and instance or instance:FindFirstChildWhichIsA("ClickDetector", true)
    return prompt, detector
end

function FarmSystem:Interact(target)
    if not target or not target.Instance or os.clock() < self.NextInteractionAt then return false end
    local prompt, cd = FindPromptOrClickDetector(target.Instance)
    local interacted = false
    if prompt and type(fireproximityprompt) == "function" then
        interacted = pcall(fireproximityprompt, prompt)
    elseif cd and type(fireclickdetector) == "function" then
        interacted = pcall(fireclickdetector, cd)
    end
    if interacted then
        self.LastUsed[target.Id] = os.clock()
        self.NextInteractionAt = os.clock() + math.max(0.05, Config.Farm.InteractionDelay)
    end
    return interacted
end

local function InstancePosition(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok and pivot then return pivot.Position end
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
    end
    if obj:IsA("Tool") then
        local h = obj:FindFirstChild("Handle")
        return h and h.Position or nil
    end
    return nil
end

local function LooksLikeBucket(obj)
    local n = string.lower(obj.Name)
    return string.find(n, "bucket", 1, true) ~= nil
        or string.find(n, "balde", 1, true) ~= nil
end

local function FindBucketTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool") and LooksLikeBucket(obj) then
                    return obj
                end
            end
        end
    end
    return nil
end

function FarmSystem:FindDroppedBuckets()
    local root = GetRoot()
    if not root then return {} end
    local found = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if LooksLikeBucket(obj) then
            local pos = InstancePosition(obj)
            if pos then
                local dist = (root.Position - pos).Magnitude
                if dist <= Config.Farm.BucketMaxDistance then
                    table.insert(found, {Instance=obj, Position=pos, Distance=dist})
                end
            end
        end
    end
    table.sort(found, function(a,b) return a.Distance < b.Distance end)
    return found
end

function FarmSystem:AcquireBucket()
    local tool = FindBucketTool()
    if tool then
        local hum = GetHumanoid()
        if hum then pcall(function() hum:EquipTool(tool) end) end
        return FindBucketTool()
    end

    local buckets = self:FindDroppedBuckets()
    local target = buckets[1]
    if not target then return nil, "No dropped bucket found" end

    if Config.Farm.BucketTeleport then
        self:TeleportTo(target.Position)
    else
        self:MoveTo(target.Position)
    end

    task.wait(0.12)
    local prompt, cd = FindPromptOrClickDetector(target.Instance)
    local ok = false
    if prompt and type(fireproximityprompt) == "function" then
        ok = pcall(fireproximityprompt, prompt)
    elseif cd and type(fireclickdetector) == "function" then
        ok = pcall(fireclickdetector, cd)
    elseif type(firetouchinterest) == "function" then
        local root = GetRoot()
        local handle = target.Instance:IsA("BasePart") and target.Instance or target.Instance:FindFirstChild("Handle", true)
        if root and handle and handle:IsA("BasePart") then
            pcall(firetouchinterest, root, handle, 0)
            task.wait(0.05)
            pcall(firetouchinterest, root, handle, 1)
            ok = true
        end
    end
    task.wait(0.15)
    tool = FindBucketTool()
    if tool then
        local hum = GetHumanoid()
        if hum then pcall(function() hum:EquipTool(tool) end) end
        return tool
    end
    return nil, ok and "Bucket interaction did not produce a Tool" or "Could not interact with dropped bucket"
end

local function GetBucketTarget(mode)
    local root = GetRoot()
    if not root then return nil end

    local candidates = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) then
            local char = plr.Character
            local pRoot = char and char:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local hp, maxHp = GetPlayerHP(plr)
                local hpPct = (hp / math.max(maxHp, 1)) * 100
                local kills = GetPlayerKills(plr)
                local dist = (root.Position - pRoot.Position).Magnitude

                table.insert(candidates, {
                    Player = plr,
                    HP = hpPct,
                    Kills = kills,
                    Distance = dist,
                    Position = pRoot.Position,
                })
            end
        end
    end

    if #candidates == 0 then return nil end

    if mode == "Low Health" then
        table.sort(candidates, function(a, b)
            if a.HP == b.HP then return a.Distance < b.Distance end
            return a.HP < b.HP
        end)
        return candidates[1].Player
    elseif mode == "Noobs / Low Kills" then
        table.sort(candidates, function(a, b)
            if a.Kills == b.Kills then return a.Distance < b.Distance end
            return a.Kills < b.Kills
        end)
        return candidates[1].Player
    else -- Nearby
        local best
        for _, c in ipairs(candidates) do
            if c.Distance <= Config.Farm.BucketSearchRadius and (not best or c.Distance < best.Distance) then
                best = c
            end
        end
        return best and best.Player or nil
    end
end

function FarmSystem:TeleportToPlayer(player)
    local targetRoot = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local root = GetRoot()
    if not targetRoot or not root then return false end

    -- Mirrors the simple reference script: use the target's actual CFrame
    -- instead of walking toward the target. The small vertical offset avoids
    -- spawning inside the player's root part.
    root.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
    return true
end

function FarmSystem:AimAndThrow(tool, player)
    if not tool or not player or not IsAlive(player) then return false end
    local char = player.Character
    local targetRoot = char and char:FindFirstChild("HumanoidRootPart")
    local root = GetRoot()
    if not targetRoot or not root then return false end

    if Config.Farm.BucketTeleport then
        if not self:TeleportToPlayer(player) then return false end
        task.wait(0.10)
    else
        local dist = (root.Position - targetRoot.Position).Magnitude
        if dist > 6 then
            self:MoveTo(targetRoot.Position)
            task.wait(0.08)
        end
    end

    -- Re-read the target position after teleporting; characters can move
    -- between target selection and the throw.
    char = player.Character
    targetRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not targetRoot or not IsAlive(player) then return false end

    local cam = Workspace.CurrentCamera
    local point, visible = cam:WorldToViewportPoint(targetRoot.Position + Vector3.new(0, 1.5, 0))
    if visible then
        local x, y = point.X, point.Y
        local ok = false
        if VirtualInputManager then
            ok = pcall(function()
                VirtualInputManager:SendMouseMoveEvent(x, y, game)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                task.wait(Config.Farm.BucketThrowDelay)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end)
        end
        if not ok and type(mouse1click) == "function" then
            pcall(mouse1click)
            ok = true
        end
        if not ok then
            ok = pcall(function() tool:Activate() end)
        end
        return ok
    end
    return pcall(function() tool:Activate() end)
end

function FarmSystem:LoopBucketAttack()
    if not Config.Farm.AutoBucketAttack or not Config.Farm.BucketAutoLoop then return false end
    if self.BucketBusy then return false end

    local target = GetBucketTarget(Config.Farm.BucketTargetMode)
    if not target then
        Config.Farm.State = "Bucket: searching target"
        return false
    end

    Config.Farm.PlayerTarget = target.Name
    local hp, maxHp = GetPlayerHP(target)
    local kills = GetPlayerKills(target)
    local hpPct = (hp / math.max(maxHp,1))*100
    local root = GetRoot()
    local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    local dist = (root and targetRoot) and (root.Position - targetRoot.Position).Magnitude or 0
    Config.Farm.PlayerState = string.format("Mode: %s | Target: %s | HP: %.0f%% | Kills: %d | Dist: %.0f", Config.Farm.BucketTargetMode, target.Name, hpPct, kills, dist)
    if hp <= 0 then return false end

    self.BucketBusy = true
    local runId = (self.BucketRunId or 0) + 1
    self.BucketRunId = runId

    task.spawn(function()
        local function done()
            if self.BucketRunId == runId then self.BucketBusy = false end
        end

        local tool = FindBucketTool()
        if not tool then
            Config.Farm.State = "Bucket: locating dropped bucket"
            tool = self:AcquireBucket()
        end

        if not tool then
            -- No bucket in inventory/world: use the nearest trash object to try
            -- to produce one, then the next loop will acquire it.
            local cans = self:FindTrashcans()
            if #cans > 0 then
                local can = cans[1]
                Config.Farm.State = "Bucket: collecting from trash"
                if can.Distance > 6 then
                    if Config.Farm.BucketTeleport then self:TeleportTo(can.Position) else self:MoveTo(can.Position) end
                else
                    self:Interact(can)
                end
            else
                Config.Farm.State = "Bucket: waiting for spawn"
            end
            done()
            return
        end

        if not IsAlive(target) then done(); return end
        local hum = GetHumanoid()
        if hum then pcall(function() hum:EquipTool(tool) end) end
        Config.Farm.State = "Bucket: aiming " .. target.Name
        local throwOk = self:AimAndThrow(tool, target)
        if throwOk then
            WatchPotentialKill(target)
        end
        task.wait(math.max(0.08, Config.Farm.BucketThrowDelay))
        CleanupExpiredKillCandidates()
        done()
    end)
    return true
end

function FarmSystem:AntiStuckCheck(dt)
    if not Config.Farm.AntiStuck then return end
    local root = GetRoot()
    if not root then return end
    if self.LastPosition then
        if (root.Position - self.LastPosition).Magnitude < 1.2 then
            self.StuckTimer += (dt or 0.08)
            if self.StuckTimer > 2.5 then
                Config.Farm.State = "Anti-Stuck"
                local hum = GetHumanoid()
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hum:MoveTo(root.Position + root.CFrame.LookVector * 8)
                end
                self.StuckTimer = 0
            end
        else
            self.StuckTimer = 0
        end
    end
    self.LastPosition = root.Position
end

function FarmSystem:LoopTrashcan()
    if not Config.Farm.AutoTrashcan and not Config.Farm.AutoBucketAttack then return end
    if Config.Farm.AutoBucketAttack then
        self:LoopBucketAttack()
        return
    end
    local cans = self:FindTrashcans()
    if #cans == 0 then
        Config.Farm.State = "Searching trash"
        Config.Farm.CurrentTarget = nil
        Config.Farm.DistanceToTarget = 0
        return
    end
    local target = cans[1]
    if not self:IsUsable(target) then return end
    Config.Farm.CurrentTarget = target.Id
    Config.Farm.DistanceToTarget = math.floor(target.Distance)
    if target.Distance > 6 then
        Config.Farm.State = "Moving to trash"
        self:MoveTo(target.Position)
    else
        Config.Farm.State = "Interacting with trash"
        local ok = self:Interact(target)
        if ok then
            Config.Farm.CurrentTarget = nil
        end
    end
end

function FarmSystem:LoopPlayerFarm()
    if not Config.Farm.PlayerFarmEnabled then
        Config.Farm.PlayerState = "Idle"
        Config.Farm.PlayerTarget = nil
        return
    end

    local targets = GetFilteredPlayerTargets()
    if #targets == 0 then
        Config.Farm.PlayerState = "No targets (enable filters / adjust ranges)"
        Config.Farm.PlayerTarget = nil
        return
    end

    local best = targets[1] -- nearest after filters
    Config.Farm.PlayerTarget = best.Player.Name
    Config.Farm.PlayerState = string.format(
        "Target: %s | Dist: %.0f | HP: %.0f%% | Kills: %d",
        best.Player.Name, best.Distance, best.HP, best.Kills
    )

    -- Move toward filtered player (selection only + chase; no auto combat claimed)
    if best.Distance > 5 then
        self:MoveTo(best.Position)
    end
end

function FarmSystem:Loop(dt)
    CleanupExpiredKillCandidates()
    if Config.Settings.Panic then
        Config.Farm.State = "Idle"
        Config.Farm.PlayerState = "Idle"
        return
    end

    self:AntiStuckCheck(dt)

    if Config.Farm.AutoTrashcan or Config.Farm.AutoBucketAttack then
        self:LoopTrashcan()
        Config.Farm.PlayerState = Config.Farm.PlayerFarmEnabled and "Paused: autonomous farm has priority" or Config.Farm.PlayerState
    elseif Config.Farm.PlayerFarmEnabled then
        Config.Farm.State = "Idle"
        self:LoopPlayerFarm()
    else
        Config.Farm.State = "Idle"
        Config.Farm.PlayerState = "Idle"
    end
end

function FarmSystem:Start()
    if self.Connection then return end
    self.Connection = TrackConnection(RunService.Heartbeat:Connect(function(dt)
        self.LastLoop += dt
        local interval = Config.Settings.PerformanceMode and 0.15 or self.LoopInterval
        if self.LastLoop < interval then return end
        local elapsed = self.LastLoop
        self.LastLoop = 0
        self:Loop(elapsed)
    end))
end

function FarmSystem:Stop()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
    Config.Farm.State = "Idle"
    Config.Farm.CurrentTarget = nil
    Config.Farm.PlayerState = "Idle"
    Config.Farm.PlayerTarget = nil
end

function FarmSystem:EnsureRunning()
    if Config.Farm.AutoTrashcan or Config.Farm.AutoBucketAttack or Config.Farm.PlayerFarmEnabled then
        self:Start()
    else
        self:Stop()
    end
end

local Farm = FarmSystem.new()

