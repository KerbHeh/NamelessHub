local function SendAutonomousInput(name)
    local resolved = ResolveInput(name)
    if not resolved then return false, "Unsupported input: " .. tostring(name) end
    local x, y = 0, 0
    if Camera then
        local vp = Camera.ViewportSize
        x, y = vp.X / 2, vp.Y / 2
    end
    if resolved.Kind == "Mouse" then
        if VirtualInputManager then
            local ok = pcall(function()
                VirtualInputManager:SendMouseButtonEvent(x, y, resolved.Value == Enum.UserInputType.MouseButton2 and 1 or 0, true, game, 0)
                task.wait(Config.Tech.AutoInputReleaseDelay)
                VirtualInputManager:SendMouseButtonEvent(x, y, resolved.Value == Enum.UserInputType.MouseButton2 and 1 or 0, false, game, 0)
            end)
            if ok then return true end
        end
        if resolved.Value == Enum.UserInputType.MouseButton1 and type(mouse1click) == "function" then
            return pcall(mouse1click)
        elseif resolved.Value == Enum.UserInputType.MouseButton2 and type(mouse2click) == "function" then
            return pcall(mouse2click)
        end
        return false, "No mouse input backend available"
    end
    if VirtualInputManager then
        local ok = pcall(function()
            VirtualInputManager:SendKeyEvent(true, resolved.Value, false, game)
            task.wait(Config.Tech.AutoInputReleaseDelay)
            VirtualInputManager:SendKeyEvent(false, resolved.Value, false, game)
        end)
        if ok then return true end
    end
    return false, "No keyboard input backend available"
end

-- TECH ENGINE (TRAINER + AUTONOMOUS INPUT)
-- ============================================================
local TechEngine = {}
TechEngine.__index = TechEngine

function TechEngine.new()
    local self = setmetatable({}, TechEngine)
    self.Running = false
    self.Mode = nil
    self.Steps = {}
    self.CurrentIndex = 0
    self.InputConn = nil
    self.WaitingInput = false
    self.WindowStart = 0
    self.WindowEnd = 0
    self.CenterTime = 0
    self.ExpectedInput = nil
    self.OnUpdate = nil
    self.Stats = {
        Correct = 0, Wrong = 0, Attempts = 0,
        Timings = {}, Accuracy = 0, AvgTiming = 0, BestTiming = math.huge,
    }
    return self
end

function TechEngine:ResetStats()
    self.Stats = {
        Correct = 0, Wrong = 0, Attempts = 0,
        Timings = {}, Accuracy = 0, AvgTiming = 0, BestTiming = math.huge,
    }
end

function TechEngine:FireUpdate(extra)
    if not self.OnUpdate then return end
    local step = self.Steps[self.CurrentIndex]
    local data = {
        Mode = self.Mode,
        CurrentStep = self.CurrentIndex,
        TotalSteps = #self.Steps,
        CurrentInput = self.ExpectedInput and InputLabel(self.ExpectedInput) or "—",
        NextInput = self.Steps[self.CurrentIndex + 1] and InputLabel(self.Steps[self.CurrentIndex + 1].Input) or "—",
        TargetDelay = step and step.DelayAfter or 0,
        ExecutionWindow = step and step.ExecutionWindow or 0,
        TimeRemaining = 0,
        Accuracy = self.Stats.Accuracy,
        Running = self.Running,
    }
    if self.WaitingInput and self.WindowEnd > 0 then
        data.TimeRemaining = math.max(0, self.WindowEnd - os.clock())
    end
    if extra then
        for k, v in pairs(extra) do data[k] = v end
    end
    self.OnUpdate(data)
end

function TechEngine:Stop()
    self.Running = false
    self.WaitingInput = false
    if self.InputConn then
        self.InputConn:Disconnect()
        self.InputConn = nil
    end
    Config.Tech.Status = "Idle"
    self:FireUpdate({ Stopped = true })
end

function TechEngine:Finish()
    self.Running = false
    self.WaitingInput = false
    if self.InputConn then
        self.InputConn:Disconnect()
        self.InputConn = nil
    end
    local total = self.Stats.Correct + self.Stats.Wrong
    self.Stats.Accuracy = total > 0 and math.floor((self.Stats.Correct / total) * 100) or 0
    local sum = 0
    for _, t in ipairs(self.Stats.Timings) do sum += t end
    self.Stats.AvgTiming = #self.Stats.Timings > 0 and (sum / #self.Stats.Timings) or 0
    for _, t in ipairs(self.Stats.Timings) do
        if t < self.Stats.BestTiming then self.Stats.BestTiming = t end
    end
    Config.Tech.Status = "Completed"
    self:FireUpdate({
        Complete = true,
        Accuracy = self.Stats.Accuracy,
        Mistakes = self.Stats.Wrong,
        AverageTiming = math.floor(self.Stats.AvgTiming * 1000),
        BestTiming = self.Stats.BestTiming == math.huge and 0 or math.floor(self.Stats.BestTiming * 1000),
    })
    Notify("TECH COMPLETE", string.format(
        "Accuracy: %d%% | Mistakes: %d | Avg: %dms | Best: %dms",
        self.Stats.Accuracy, self.Stats.Wrong,
        math.floor(self.Stats.AvgTiming * 1000),
        self.Stats.BestTiming == math.huge and 0 or math.floor(self.Stats.BestTiming * 1000)
    ), 5)
end

function TechEngine:OpenWindowForCurrentStep()
    local step = self.Steps[self.CurrentIndex]
    if not step then return end
    self.ExpectedInput = step.Input
    local now = os.clock()
    local center = now + step.DelayAfter
    local half = step.ExecutionWindow
    self.CenterTime = center
    self.WindowStart = center - half
    self.WindowEnd = center + half
    self.WaitingInput = true
    self:FireUpdate({ Phase = "WaitingInput" })
end

function TechEngine:AdvancePractice()
    self.CurrentIndex += 1
    if self.CurrentIndex > #self.Steps then
        self:Finish()
        return
    end
    local step = self.Steps[self.CurrentIndex]
    self.ExpectedInput = step.Input
    if step.DelayBefore > 0 then
        self:FireUpdate({ Phase = "DelayBefore" })
        task.wait(step.DelayBefore)
        if not self.Running then return end
    end
    self:OpenWindowForCurrentStep()

    task.spawn(function()
        local deadline = self.WindowEnd + 0.2
        while self.Running and self.WaitingInput and os.clock() < deadline do
            self:FireUpdate({ Phase = "WaitingInput" })
            task.wait(0.03)
        end
        if self.Running and self.WaitingInput and self.CurrentIndex == step.Index then
            self.WaitingInput = false
            self.Stats.Wrong += 1
            local total = self.Stats.Correct + self.Stats.Wrong
            self.Stats.Accuracy = math.floor((self.Stats.Correct / math.max(total, 1)) * 100)
            self:FireUpdate({ Result = "Miss", Accuracy = self.Stats.Accuracy })
            if Config.Tech.RetryOnMiss then
                task.wait(0.25)
                if self.Running then
                    self.CurrentIndex -= 1
                    self:AdvancePractice()
                end
            else
                task.wait(0.2)
                if self.Running then self:AdvancePractice() end
            end
        end
    end)
end

function TechEngine:OnUserInput(input)
    if not self.Running or not self.WaitingInput or self.Mode ~= "Practice" then return end
    if input.UserInputState ~= Enum.UserInputState.Begin then return end

    local step = self.Steps[self.CurrentIndex]
    if not step then return end

    local now = os.clock()
    local correctInput = MatchInput(input, step.Input)
    local inWindow = (now >= self.WindowStart and now <= self.WindowEnd)
    local timingError = math.abs(now - self.CenterTime)

    if not correctInput then
        self.WaitingInput = false
        self.Stats.Wrong += 1
        local total = self.Stats.Correct + self.Stats.Wrong
        self.Stats.Accuracy = math.floor((self.Stats.Correct / math.max(total, 1)) * 100)
        self:FireUpdate({ Result = "WrongInput", Accuracy = self.Stats.Accuracy })
        if Config.Tech.RetryOnMiss then
            task.delay(0.15, function()
                if self.Running then
                    self.CurrentIndex -= 1
                    self:AdvancePractice()
                end
            end)
        else
            table.insert(self.Stats.Timings, timingError)
            task.delay(0.15, function()
                if self.Running then self:AdvancePractice() end
            end)
        end
        return
    end

    self.WaitingInput = false
    table.insert(self.Stats.Timings, timingError)

    if inWindow then
        self.Stats.Correct += 1
        local total = self.Stats.Correct + self.Stats.Wrong
        self.Stats.Accuracy = math.floor((self.Stats.Correct / math.max(total, 1)) * 100)
        self:FireUpdate({ Result = "Hit", Accuracy = self.Stats.Accuracy })
        task.wait(0.12)
        if self.Running then self:AdvancePractice() end
    else
        self.Stats.Wrong += 1
        local total = self.Stats.Correct + self.Stats.Wrong
        self.Stats.Accuracy = math.floor((self.Stats.Correct / math.max(total, 1)) * 100)
        local tag = now < self.WindowStart and "Early" or "Late"
        self:FireUpdate({ Result = tag, Accuracy = self.Stats.Accuracy })
        if Config.Tech.RetryOnMiss then
            task.wait(0.25)
            if self.Running then
                self.CurrentIndex -= 1
                self:AdvancePractice()
            end
        else
            task.wait(0.15)
            if self.Running then self:AdvancePractice() end
        end
    end
end

function TechEngine:StartAuto(tech, presetName, onUpdate)
    if self.Running then return false, "Already running" end
    if not IsConfigured(tech) then
        return false, "UNCONFIGURED — configure the Tech steps first."
    end
    self:ResetStats()
    self.Steps = BuildActiveSteps(tech, presetName)
    if #self.Steps == 0 then return false, "No steps" end

    self.Mode = "Auto"
    self.Running = true
    self.CurrentIndex = 0
    self.OnUpdate = onUpdate
    Config.Tech.Status = "Running"
    Config.Tech.CurrentTechId = tech.Id

    task.spawn(function()
        task.wait(Config.Tech.AutoStartDelay)
        while self.Running do
            for i, step in ipairs(self.Steps) do
                if not self.Running then break end
                self.CurrentIndex = i
                self.ExpectedInput = step.Input
                if step.DelayBefore > 0 then
                    self:FireUpdate({Phase="DelayBefore"})
                    task.wait(step.DelayBefore)
                end
                if not self.Running then break end
                local ok, err = SendAutonomousInput(step.Input)
                if not ok then
                    self.Running = false
                    Config.Tech.Status = "Error"
                    self:FireUpdate({Error=err or "Input failed"})
                    Notify("AUTO TECH ERROR", err or "Could not send input", 5)
                    return
                end
                self.Stats.Correct += 1
                local total = self.Stats.Correct + self.Stats.Wrong
                self.Stats.Accuracy = math.floor((self.Stats.Correct / math.max(total,1))*100)
                self:FireUpdate({Phase="Execute", Result="Auto", Accuracy=self.Stats.Accuracy})
                task.wait(step.DelayAfter)
            end
            if not Config.Tech.AutoLoop then break end
            task.wait(Config.Tech.AutoStartDelay)
        end
        if self.Running then self:Finish() end
    end)
    self:FireUpdate({Started=true, Auto=true})
    return true
end

function TechEngine:StartPractice(tech, presetName, onUpdate)
    if self.Running then return false, "Already running" end
    if not IsConfigured(tech) then
        return false, "UNCONFIGURED — Configure Steps before using this Tech."
    end
    self:ResetStats()
    self.Stats.Attempts += 1
    self.Steps = BuildActiveSteps(tech, presetName)
    if #self.Steps == 0 then return false, "No steps" end

    self.Mode = "Practice"
    self.Running = true
    self.CurrentIndex = 0
    self.OnUpdate = onUpdate
    Config.Tech.Status = "Running"
    Config.Tech.CurrentTechId = tech.Id

    self.InputConn = TrackConnection(UserInputService.InputBegan:Connect(function(input)
        self:OnUserInput(input)
    end))

    self:FireUpdate({ Started = true })
    task.spawn(function()
        task.wait(0.35)
        if self.Running then self:AdvancePractice() end
    end)
    return true
end

function TechEngine:StartDemo(tech, presetName, onUpdate)
    if self.Running then return false, "Already running" end
    if not IsConfigured(tech) then
        return false, "UNCONFIGURED — Configure Steps before using this Tech."
    end
    self.Steps = BuildActiveSteps(tech, presetName)
    if #self.Steps == 0 then return false, "No steps" end

    self.Mode = "Demo"
    self.Running = true
    self.CurrentIndex = 0
    self.OnUpdate = onUpdate
    Config.Tech.Status = "Running"
    Config.Tech.CurrentTechId = tech.Id

    local lines = {}
    for i, s in ipairs(self.Steps) do
        table.insert(lines, InputLabel(s.Input))
        if i < #self.Steps then
            table.insert(lines, string.format("↓ %.3fs", s.DelayAfter))
        end
    end
    self:FireUpdate({ DemoPreview = true, SequenceText = table.concat(lines, "\n") })

    task.spawn(function()
        task.wait(1.4)
        if not self.Running then return end
        for i, step in ipairs(self.Steps) do
            if not self.Running then break end
            self.CurrentIndex = i
            self.ExpectedInput = step.Input
            if step.DelayBefore > 0 then
                self:FireUpdate({ Phase = "DelayBefore" })
                task.wait(step.DelayBefore)
                if not self.Running then break end
            end
            self:FireUpdate({ Phase = "Execute", Highlight = true })
            task.wait(step.DelayAfter)
        end
        if self.Running then
            self.Running = false
            Config.Tech.Status = "Completed"
            self:FireUpdate({ Complete = true, Demo = true })
            Notify("Demo Finished", tech.Name)
        end
    end)
    return true
end

