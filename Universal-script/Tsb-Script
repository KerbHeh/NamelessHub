--==================================================
-- FARM LOOP
--==================================================

local LastInteraction = 0
local LastPosition = nil
local StuckTime = 0

task.spawn(function()

    while task.wait(0.08) do

        if not Config.Farm.Enabled then
            continue
        end

        local Root = GetRoot()
        local Humanoid = GetHumanoid()

        if not Root or not Humanoid then
            FarmStatus:SetDesc("Waiting for character...")
            continue
        end

        Humanoid.WalkSpeed = Config.Farm.Speed

        -- Anti-Stuck
        if Config.Farm.AntiStuck then

            if LastPosition then

                local Movement =
                    (Root.Position - LastPosition).Magnitude

                if Movement < 1 then
                    StuckTime += 0.08
                else
                    StuckTime = 0
                end

                if StuckTime > 2 then

                    Humanoid:ChangeState(
                        Enum.HumanoidStateType.Jumping
                    )

                    Humanoid:MoveTo(
                        Root.Position +
                        Root.CFrame.LookVector * 8
                    )

                    StuckTime = 0
                end
            end

            LastPosition = Root.Position
        end

        local Target = GetClosestTrashcan()

        if not Target then
            FarmStatus:SetDesc(
                "No trashcan found nearby."
            )

            continue
        end

        local Distance =
            (Root.Position - Target.Part.Position).Magnitude

        if Distance > 6 then

            FarmStatus:SetDesc(
                string.format(
                    "Moving to trashcan | %.0f studs",
                    Distance
                )
            )

            Humanoid:MoveTo(Target.Part.Position)

        else

            FarmStatus:SetDesc(
                "Interacting with trashcan..."
            )

            if os.clock() - LastInteraction >= Config.Farm.Delay then

                local Prompt =
                    Target.Object:FindFirstChildWhichIsA(
                        "ProximityPrompt",
                        true
                    )

                if Prompt and
                    type(fireproximityprompt) == "function" then

                    pcall(function()
                        fireproximityprompt(Prompt)
                    end)

                else

                    local Detector =
                        Target.Object:FindFirstChildWhichIsA(
                            "ClickDetector",
                            true
                        )

                    if Detector and
                        type(fireclickdetector) == "function" then

                        pcall(function()
                            fireclickdetector(Detector)
                        end)
                    end
                end

                LastInteraction = os.clock()
            end
        end
    end
end)

