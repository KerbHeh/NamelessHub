--==================================================
-- HELPERS
--==================================================

local function GetCharacter()
    return LocalPlayer.Character
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function GetTrashFolder()
    local Map = workspace:FindFirstChild("Map")
    if not Map then
        return nil
    end

    return Map:FindFirstChild("Trash")
end

local function GetTrashcans()
    local Folder = GetTrashFolder()

    if not Folder then
        return {}
    end

    local Result = {}

    for _, Object in ipairs(Folder:GetChildren()) do
        if Object:IsA("Model") and Object.Name == "Trashcan" then
            local Part =
                Object.PrimaryPart
                or Object:FindFirstChildWhichIsA("BasePart", true)

            if Part then
                table.insert(Result, {
                    Object = Object,
                    Part = Part,
                    Distance = 0
                })
            end
        end
    end

    return Result
end

local function GetClosestTrashcan()
    local Root = GetRoot()

    if not Root then
        return nil
    end

    local Closest = nil
    local ClosestDistance = Config.Farm.MaxDistance

    for _, Trash in ipairs(GetTrashcans()) do
        if Trash.Part and Trash.Part.Parent then
            local Distance =
                (Root.Position - Trash.Part.Position).Magnitude

            if Distance < ClosestDistance then
                ClosestDistance = Distance
                Trash.Distance = Distance
                Closest = Trash
            end
        end
    end

    return Closest
end

